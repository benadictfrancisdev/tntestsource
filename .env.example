# Frontend Environment Variables (Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_TURNSTILE_SITE_KEY=""
VITE_GA_ID=""

# Supabase Edge Function Secrets (Configured in Supabase Dashboard / CLI)
# RESEND_API_KEY: Resend API key for dispatching notification and acknowledgement emails
RESEND_API_KEY=""

# TURNSTILE_SECRET_KEY: Cloudflare Turnstile secret key for server-side verification
TURNSTILE_SECRET_KEY=""

# INBOX_EMAIL: Destination inbox for notification emails (benadictfrancis.dev@gmail.com)
INBOX_EMAIL="benadictfrancis.dev@gmail.com"

# FROM_EMAIL: Verified sender address for outgoing acknowledgement emails
FROM_EMAIL="enquiries@example.com"

# IP_HASH_SALT: Secret salt string used for SHA-256 IP hashing for rate limiting
IP_HASH_SALT=""

# SITE_URL: Canonical base URL of the website
SITE_URL="https://example.com"
